{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/components/ui/*": ["./components/ui/*"],
      "@/components/motion-primitives/*": ["./components/ui/motion-primitives/*"],
      "@/hooks/*": ["./app/hooks/*"],
      "@/hooks/use-mounted": ["./hooks/use-mounted.ts"],
      "@/hooks/prediction/*": ["./hooks/prediction/*"],
      "@/hooks/portfolio/*": ["./hooks/portfolio/*"],
      "@/hooks/leaderboard/*": ["./hooks/leaderboard/*"],
      "@/hooks/profile/*": ["./hooks/profile/*"],
      "@/hooks/community/*": ["./hooks/community/*"],
      "@/hooks/markets/*": ["./hooks/markets/*"],
      "@/lib/*": ["./lib/*"],
      "@/lib/utils": ["./lib/utils.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
